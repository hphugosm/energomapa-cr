{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnergoMapa facility point layer",
  "description": "Feature.id is the stable pointid; IDs are unique within a layer. Municipality IDs must reference a known municipality. Runtime validation checks these cross-record constraints.",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodology": {
          "type": "string"
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "municipalityId",
        "metrics"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "power_plant",
            "battery",
            "charger",
            "industry",
            "heating"
          ]
        },
        "municipalityId": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "patternProperties": {
              "^[0-9]{4}$": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "path",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "power_plant",
            "battery",
            "charger",
            "industry",
            "heating"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "properties": {
          "$ref": "#/$defs/properties"
        }
      }
    }
  }
}
