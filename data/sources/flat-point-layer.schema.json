{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnergoMapa flat point layer",
  "type": "object",
  "required": [
    "schemaVersion",
    "layerId",
    "source",
    "points"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layerId": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "url"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "lat",
          "lon",
          "municipalityCode",
          "regionCode",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "municipalityCode": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "regionCode": {
            "type": "string",
            "pattern": "^CZ[0-9]{3}$"
          },
          "properties": {
            "type": "object"
          }
        }
      }
    }
  }
}
