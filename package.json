{
  "name": "energomapa-cz",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Statický manifestem řízený energetický atlas České republiky",
  "scripts": {
    "data": "python3 pipeline/build.py",
    "data:databank": "python3 pipeline/build.py --download-databank",
    "test": "node --test tests/*.test.mjs",
    "build": "python3 pipeline/build.py && python3 pipeline/package.py",
    "serve": "python3 -m http.server 4173 --directory public --bind 127.0.0.1",
    "test:browser": "node tests/browser-remediation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.58.2"
  }
}
